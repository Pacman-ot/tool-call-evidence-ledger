# Copy to .env for local development. Never commit real keys.
LEDGER_DB_PATH=./data/ledger.db
LEDGER_STORAGE_BACKEND=sqlite
# On Vercel the filesystem is ephemeral; default path becomes /tmp/ledger.db
# LEDGER_DB_PATH=/tmp/ledger.db
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_JUDGE_ENABLED=false
SCHEMA_VERSION=1
